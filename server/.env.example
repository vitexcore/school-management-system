# School Management System - Backend Environment Variables
# Copy this file to .env and fill in production values

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://vitex:vitex@localhost:5432/school_management?schema=public"

# JWT secrets (replace with long random strings in production)
ACCESS_TOKEN_SECRET="replace-with-a-long-random-access-secret"
REFRESH_TOKEN_SECRET="replace-with-a-long-random-refresh-secret"

# CSRF secret (replace with a long random string in production)
CSRF_SECRET="replace-with-a-long-random-csrf-secret"

# Frontend origin (CORS is locked to this origin only)
CORS_ORIGIN="http://localhost:5173"

# Set "true" when serving over HTTPS (required in production)
COOKIE_SECURE="false"

MAX_FAILED_LOGINS="5"
LOCKOUT_MINUTES="15"

# Seed superadmin (created by `npm run seed`)
SEED_ADMIN_EMAIL="superadmin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Super Administrator"
SEED_DEMO_PASSWORD=""

# Paystack (optional until online collections are enabled)
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Daily database backup script
BACKUP_DIR="/var/backups/school-management"
BACKUP_RETENTION_DAYS="14"
REPORT_EXPORT_DIR="/var/lib/school-management/exports"

# Subscription expiration grace period
SUBSCRIPTION_GRACE_DAYS="7"
