{
  "name": "school-management-server",
  "version": "1.0.0",
  "description": "Multi-tenant school management system backend",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "audit": "npm audit",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "find src test prisma scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "backup": "sh scripts/backup-database.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "axios": "^1.21.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.14.1",
    "pino": "^9.7.0",
    "prisma": "^6.5.0",
    "sanitize-html": "^2.17.5",
    "supertest": "^7.3.2",
    "uuid": "^14.0.3",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
