POSTGRES_DB=school_management
POSTGRES_USER=school
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://school:replace-with-a-long-random-password@db:5432/school_management?schema=public
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGIN=https://school.example.com
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_DAYS=7
BACKUP_DIR=/var/backups/school-management
BACKUP_RETENTION_DAYS=14
REPORT_EXPORT_DIR=/var/lib/school-management/exports
HTTP_PORT=80
